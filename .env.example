DATABASE_URL="postgresql://dogfood:dogfood@localhost:5432/dogfood"
NEXTAUTH_SECRET="dev-only-change-me-before-real-use"
NEXTAUTH_URL="http://localhost:3000"

# --- Submission deadline (home page countdown) ---
# ISO format with timezone. +05:30 = IST.
# NEXT_PUBLIC_ variables are baked in at build time, so rebuild after changing.
NEXT_PUBLIC_SUBMISSION_DEADLINE="2026-10-15T18:00:00+05:30"

# --- Email (for registration OTP verification) ---
# Leave EMAIL_PROVIDER unset (or "console") for local/demo use: OTP codes
# are logged to the server console AND returned in the API response, so
# registration works with zero setup. This is NOT secure for a real
# deployment — switch to a real provider before going live.
#
# EMAIL_PROVIDER="smtp"
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER="your-smtp-username"
# SMTP_PASS="your-smtp-password"
# EMAIL_FROM="noreply@yourdomain.com"
#
# OR, using Brevo's transactional email API instead of SMTP:
# EMAIL_PROVIDER="brevo"
# BREVO_API_KEY="your-brevo-api-key"
# EMAIL_FROM="noreply@yourdomain.com"